{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suisha",
  "mainBinaryName": "suisha",
  "version": "0.7.0",
  "identifier": "dev.moriyama.suisha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Suisha",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Keep your apps up to date on Ubuntu and macOS",
    "longDescription": "Suisha brings apt, snap, Flatpak, Homebrew and the Mac App Store together in one window: search and install, see what is installed, update everything on a schedule, and set up a new computer from a saved list.",
    "copyright": "Copyright (c) 2026 Yoshiro Moriyama",
    "license": "MIT",
    "homepage": "https://github.com/moriyama-dev/suisha",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": [
          "suisha-cli (>= 0.7.0)",
          "pkexec | policykit-1"
        ],
        "recommends": [
          "libnotify-bin"
        ],
        "section": "admin"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
