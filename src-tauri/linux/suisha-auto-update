#!/bin/sh
# Updates every apt and snap package. Takes no arguments.
# Run through pkexec (polkit action dev.moriyama.suisha.auto-update). Users
# who turned on automatic updates in Suisha may run it without a password.
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive
umask 022

if [ "$#" -ne 0 ]; then
    echo "suisha-auto-update: takes no arguments" >&2
    exit 64
fi

status=0
if command -v apt-get >/dev/null 2>&1; then
    apt-get -y -o DPkg::Lock::Timeout=300 update || status=1
    apt-get -y -o DPkg::Lock::Timeout=300 \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        upgrade --with-new-pkgs || status=1
fi
if command -v snap >/dev/null 2>&1; then
    snap refresh || status=1
fi
exit $status
