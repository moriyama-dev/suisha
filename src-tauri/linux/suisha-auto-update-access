#!/bin/sh
# Lets the calling user run one of Suisha's update helpers without a
# password (enable), or takes that permission back (disable).
#
# Usage: suisha-auto-update-access enable|disable [auto-update|self-update]
#   auto-update (default): /usr/lib/suisha/suisha-auto-update
#   self-update:           /usr/lib/suisha/suisha-self-update
#
# The user is taken from PKEXEC_UID, never from the arguments.
# Run through pkexec (polkit action dev.moriyama.suisha.configure).
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

action="${1:-}"
case "$action" in
    enable|disable) ;;
    *) echo "usage: suisha-auto-update-access enable|disable [auto-update|self-update]" >&2; exit 64 ;;
esac

kind="${2:-auto-update}"
case "$kind" in
    auto-update|self-update) ;;
    *) echo "suisha-auto-update-access: unknown helper: $kind" >&2; exit 64 ;;
esac

uid="${PKEXEC_UID:-}"
case "$uid" in
    ""|*[!0-9]*) echo "suisha-auto-update-access: run this through pkexec" >&2; exit 64 ;;
esac
user="$(id -nu "$uid")" || exit 1
case "$user" in
    ""|-*|*[!A-Za-z0-9._-]*) echo "suisha-auto-update-access: unsupported user name" >&2; exit 64 ;;
esac

rules_dir=/etc/polkit-1/rules.d
pkla_dir=/etc/polkit-1/localauthority/50-local.d
rules="$rules_dir/49-suisha-$kind-$user.rules"
pkla="$pkla_dir/49-suisha-$kind-$user.pkla"

if [ "$action" = disable ]; then
    rm -f "$rules" "$pkla"
    exit 0
fi

if [ -d "$rules_dir" ]; then
    cat > "$rules" <<RULES
// Written by Suisha at the request of $user.
// Lets $user run /usr/lib/suisha/suisha-$kind without a password.
polkit.addRule(function (action, subject) {
    if (action.id === "dev.moriyama.suisha.$kind" && subject.user === "$user") {
        return polkit.Result.YES;
    }
});
RULES
fi
if [ -d /etc/polkit-1/localauthority ]; then
    mkdir -p "$pkla_dir"
    cat > "$pkla" <<PKLA
[Suisha $kind for $user]
Identity=unix-user:$user
Action=dev.moriyama.suisha.$kind
ResultAny=yes
ResultInactive=yes
ResultActive=yes
PKLA
fi
exit 0
